{
  "$defs": {
    "CallTrace": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "provider": {
          "default": "openai",
          "title": "Provider",
          "type": "string"
        },
        "raw_response_path": {
          "title": "Raw Response Path",
          "type": "string"
        },
        "reasoning_effort": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reasoning Effort"
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Request Id"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "usage": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usage"
        }
      },
      "required": [
        "stage",
        "model_name",
        "prompt_version",
        "prompt_hash",
        "input_hash",
        "raw_response_path"
      ],
      "title": "CallTrace",
      "type": "object"
    },
    "ImageRef": {
      "additionalProperties": false,
      "description": "CIRR image metadata used for visual validation and downstream training.",
      "properties": {
        "image_id": {
          "minLength": 1,
          "title": "Image Id",
          "type": "string"
        },
        "image_path": {
          "minLength": 1,
          "title": "Image Path",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "image_path"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "ParaphraseMetrics": {
      "additionalProperties": false,
      "properties": {
        "char_edit_distance": {
          "minimum": 0,
          "title": "Char Edit Distance",
          "type": "integer"
        },
        "length_ratio": {
          "exclusiveMinimum": 0,
          "title": "Length Ratio",
          "type": "number"
        },
        "normalized_char_edit_distance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Normalized Char Edit Distance",
          "type": "number"
        },
        "normalized_token_edit_distance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Normalized Token Edit Distance",
          "type": "number"
        },
        "paraphrase_char_count": {
          "minimum": 1,
          "title": "Paraphrase Char Count",
          "type": "integer"
        },
        "paraphrase_token_count": {
          "minimum": 1,
          "title": "Paraphrase Token Count",
          "type": "integer"
        },
        "source_char_count": {
          "minimum": 1,
          "title": "Source Char Count",
          "type": "integer"
        },
        "source_token_count": {
          "minimum": 1,
          "title": "Source Token Count",
          "type": "integer"
        },
        "token_edit_distance": {
          "minimum": 0,
          "title": "Token Edit Distance",
          "type": "integer"
        },
        "token_jaccard": {
          "maximum": 1,
          "minimum": 0,
          "title": "Token Jaccard",
          "type": "number"
        }
      },
      "required": [
        "source_char_count",
        "paraphrase_char_count",
        "source_token_count",
        "paraphrase_token_count",
        "length_ratio",
        "char_edit_distance",
        "normalized_char_edit_distance",
        "token_edit_distance",
        "normalized_token_edit_distance",
        "token_jaccard"
      ],
      "title": "ParaphraseMetrics",
      "type": "object"
    },
    "PositiveParaphrase": {
      "additionalProperties": false,
      "properties": {
        "metrics": {
          "$ref": "#/$defs/ParaphraseMetrics"
        },
        "paraphrase_id": {
          "minLength": 1,
          "title": "Paraphrase Id",
          "type": "string"
        },
        "review_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Reason"
        },
        "rewrite_strategy": {
          "minLength": 1,
          "title": "Rewrite Strategy",
          "type": "string"
        },
        "status": {
          "default": "generated",
          "enum": [
            "generated",
            "accepted",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "paraphrase_id",
        "text",
        "rewrite_strategy",
        "metrics"
      ],
      "title": "PositiveParaphrase",
      "type": "object"
    },
    "PositiveParaphraseMetadata": {
      "additionalProperties": false,
      "properties": {
        "build_fingerprint": {
          "minLength": 1,
          "title": "Build Fingerprint",
          "type": "string"
        },
        "call_traces": {
          "items": {
            "$ref": "#/$defs/CallTrace"
          },
          "title": "Call Traces",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "generator_model": {
          "minLength": 1,
          "title": "Generator Model",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "num_accepted": {
          "default": 0,
          "minimum": 0,
          "title": "Num Accepted",
          "type": "integer"
        },
        "num_generated": {
          "default": 0,
          "minimum": 0,
          "title": "Num Generated",
          "type": "integer"
        },
        "operational_status": {
          "default": "ok",
          "enum": [
            "ok",
            "failed"
          ],
          "title": "Operational Status",
          "type": "string"
        },
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "requested_variants": {
          "maximum": 20,
          "minimum": 1,
          "title": "Requested Variants",
          "type": "integer"
        },
        "reviewer_model": {
          "minLength": 1,
          "title": "Reviewer Model",
          "type": "string"
        }
      },
      "required": [
        "requested_variants",
        "generator_model",
        "reviewer_model",
        "prompt_version",
        "build_fingerprint"
      ],
      "title": "PositiveParaphraseMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/PositiveParaphrase"
      },
      "title": "Candidates",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/PositiveParaphraseMetadata"
    },
    "pair_id": {
      "minimum": 0,
      "title": "Pair Id",
      "type": "integer"
    },
    "paraphrases": {
      "items": {
        "$ref": "#/$defs/PositiveParaphrase"
      },
      "title": "Paraphrases",
      "type": "array"
    },
    "positive_text": {
      "minLength": 1,
      "title": "Positive Text",
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/ImageRef"
    },
    "sample_id": {
      "pattern": "^cirr_train_\\d+$",
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ImageRef"
    }
  },
  "required": [
    "sample_id",
    "pair_id",
    "reference",
    "target",
    "positive_text",
    "metadata"
  ],
  "title": "PositiveParaphraseRecord",
  "type": "object"
}
