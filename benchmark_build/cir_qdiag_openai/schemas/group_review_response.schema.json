{
  "$defs": {
    "CandidateVerdict": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": [
            "accept",
            "reject"
          ],
          "title": "Decision",
          "type": "string"
        },
        "failure_code": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReviewFailureCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "negative_id": {
          "minLength": 1,
          "title": "Negative Id",
          "type": "string"
        },
        "reason": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "negative_id",
        "decision",
        "failure_code",
        "reason"
      ],
      "title": "CandidateVerdict",
      "type": "object"
    },
    "ReviewFailureCode": {
      "enum": [
        "not_single_edit",
        "wrong_semantic_target",
        "not_fluent",
        "not_close_or_hard",
        "positive_compatible",
        "not_visually_verifiable",
        "invalid_delete",
        "other_semantic_failure"
      ],
      "title": "ReviewFailureCode",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Exactly one verdict for every candidate in a PinPoint group.",
  "properties": {
    "verdicts": {
      "items": {
        "$ref": "#/$defs/CandidateVerdict"
      },
      "title": "Verdicts",
      "type": "array"
    }
  },
  "required": [
    "verdicts"
  ],
  "title": "GroupReviewResponse",
  "type": "object"
}
