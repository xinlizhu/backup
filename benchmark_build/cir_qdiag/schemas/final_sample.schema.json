{
  "$defs": {
    "CallTrace": {
      "additionalProperties": false,
      "properties": {
        "attempts": {
          "default": 1,
          "title": "Attempts",
          "type": "integer"
        },
        "cached": {
          "default": false,
          "title": "Cached",
          "type": "boolean"
        },
        "effective_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Seed"
        },
        "input_hash": {
          "title": "Input Hash",
          "type": "string"
        },
        "model_name": {
          "title": "Model Name",
          "type": "string"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "prompt_hash": {
          "title": "Prompt Hash",
          "type": "string"
        },
        "prompt_version": {
          "minLength": 1,
          "title": "Prompt Version",
          "type": "string"
        },
        "raw_response_path": {
          "title": "Raw Response Path",
          "type": "string"
        },
        "seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seed"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "temperature": {
          "title": "Temperature",
          "type": "number"
        }
      },
      "required": [
        "stage",
        "model_name",
        "temperature",
        "prompt_version",
        "prompt_hash",
        "input_hash",
        "raw_response_path"
      ],
      "title": "CallTrace",
      "type": "object"
    },
    "ConstructionMode": {
      "enum": [
        "text_only_editable",
        "vision_grounded"
      ],
      "title": "ConstructionMode",
      "type": "string"
    },
    "EditOperation": {
      "enum": [
        "add",
        "delete",
        "substitute"
      ],
      "title": "EditOperation",
      "type": "string"
    },
    "ImageRef": {
      "additionalProperties": false,
      "properties": {
        "image_id": {
          "title": "Image Id",
          "type": "string"
        },
        "image_path": {
          "title": "Image Path",
          "type": "string"
        }
      },
      "required": [
        "image_id",
        "image_path"
      ],
      "title": "ImageRef",
      "type": "object"
    },
    "NegativeCandidate": {
      "additionalProperties": false,
      "properties": {
        "after_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "After Span"
        },
        "before_span": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Before Span"
        },
        "change_summary": {
          "maxLength": 400,
          "minLength": 1,
          "title": "Change Summary",
          "type": "string"
        },
        "construction_mode": {
          "$ref": "#/$defs/ConstructionMode"
        },
        "edit_operation": {
          "$ref": "#/$defs/EditOperation"
        },
        "generation_attempts": {
          "default": 1,
          "minimum": 1,
          "title": "Generation Attempts",
          "type": "integer"
        },
        "negative_id": {
          "minLength": 1,
          "title": "Negative Id",
          "type": "string"
        },
        "selection_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Reason"
        },
        "semantic_target": {
          "$ref": "#/$defs/SemanticTarget"
        },
        "status": {
          "default": "generated",
          "enum": [
            "generated",
            "accepted",
            "rejected",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "visual_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visual Basis"
        }
      },
      "required": [
        "negative_id",
        "text",
        "semantic_target",
        "edit_operation",
        "construction_mode",
        "before_span",
        "after_span",
        "change_summary"
      ],
      "title": "NegativeCandidate",
      "type": "object"
    },
    "SampleMetadata": {
      "additionalProperties": false,
      "properties": {
        "build_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Build Fingerprint"
        },
        "call_traces": {
          "items": {
            "$ref": "#/$defs/CallTrace"
          },
          "title": "Call Traces",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "generator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generator Model"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        },
        "num_accepted_negatives": {
          "default": 0,
          "title": "Num Accepted Negatives",
          "type": "integer"
        },
        "num_generated_candidates": {
          "default": 0,
          "title": "Num Generated Candidates",
          "type": "integer"
        },
        "operational_status": {
          "default": "pending",
          "enum": [
            "pending",
            "ok",
            "failed"
          ],
          "title": "Operational Status",
          "type": "string"
        },
        "prompt_version": {
          "default": "v5",
          "title": "Prompt Version",
          "type": "string"
        },
        "random_seed": {
          "default": 42,
          "title": "Random Seed",
          "type": "integer"
        },
        "selection_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selection Fingerprint"
        },
        "semantic_status": {
          "default": "pending",
          "enum": [
            "pending",
            "accepted",
            "partial",
            "rejected"
          ],
          "title": "Semantic Status",
          "type": "string"
        },
        "source_screen_decision": {
          "default": "pending",
          "enum": [
            "pending",
            "keep",
            "drop"
          ],
          "title": "Source Screen Decision",
          "type": "string"
        },
        "source_screen_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Screen Reason"
        },
        "stage": {
          "default": "source",
          "enum": [
            "source",
            "screened",
            "candidates",
            "final"
          ],
          "title": "Stage",
          "type": "string"
        },
        "validator_model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validator Model"
        }
      },
      "title": "SampleMetadata",
      "type": "object"
    },
    "SemanticTarget": {
      "enum": [
        "object",
        "attribute",
        "predicate"
      ],
      "title": "SemanticTarget",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "candidates": {
      "items": {
        "$ref": "#/$defs/NegativeCandidate"
      },
      "title": "Candidates",
      "type": "array"
    },
    "image_set": {
      "items": {
        "type": "string"
      },
      "title": "Image Set",
      "type": "array"
    },
    "metadata": {
      "$ref": "#/$defs/SampleMetadata"
    },
    "negatives": {
      "items": {
        "$ref": "#/$defs/NegativeCandidate"
      },
      "title": "Negatives",
      "type": "array"
    },
    "pair_id": {
      "title": "Pair Id",
      "type": "integer"
    },
    "positive_text": {
      "minLength": 1,
      "title": "Positive Text",
      "type": "string"
    },
    "reference": {
      "$ref": "#/$defs/ImageRef"
    },
    "sample_id": {
      "title": "Sample Id",
      "type": "string"
    },
    "schema_version": {
      "const": "5.0",
      "default": "5.0",
      "title": "Schema Version",
      "type": "string"
    },
    "source_dataset": {
      "const": "CIRR",
      "default": "CIRR",
      "title": "Source Dataset",
      "type": "string"
    },
    "split": {
      "default": "val",
      "enum": [
        "train",
        "val"
      ],
      "title": "Split",
      "type": "string"
    },
    "target": {
      "$ref": "#/$defs/ImageRef"
    }
  },
  "required": [
    "sample_id",
    "pair_id",
    "reference",
    "target",
    "positive_text"
  ],
  "title": "SampleRecord",
  "type": "object"
}
